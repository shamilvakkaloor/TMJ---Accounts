{
  "name": "mahal-accounts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run tests/domain.test.ts tests/urls.test.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-mahal \"vitest run tests/rules.test.ts\"",
    "test:restore": "firebase emulators:exec --only firestore --project demo-mahal \"tsx scripts/verify-restore.ts\"",
    "check": "npm run build && npm test",
    "test:e2e": "playwright test",
    "test:pages": "playwright test --config playwright.pages.config.ts"
  },
  "dependencies": {
    "@zxing/browser": "^0.1.5",
    "firebase": "^12.0.0",
    "lucide-react": "^0.468.0",
    "papaparse": "^5.5.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^14.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}

rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function admin() { return request.auth != null && request.auth.uid in ["sSrHlyKjlseo8ncOluufxbJOce72", "G0YLplPHzlT8dJVIVA5wWwLZCPJ3"]; }
  function before(c,id) { return get(/databases/$(database)/documents/$(c)/$(id)).data; }
  function after(c,id) { return getAfter(/databases/$(database)/documents/$(c)/$(id)).data; }
  function bootstrap() { return !exists(/databases/$(database)/documents/meta/revision) && after('meta','revision').lastOperation == 'bootstrap'; }
  function operation() { return after('operations',after('meta','revision').lastOperation); }
  function fresh(o) { return !exists(/databases/$(database)/documents/operations/$(o.id)); }
  function edit(kind) { return admin() && operation().kind == kind && fresh(operation()); }
  function intAmount(n) { return n is int && n >= 0 && n <= 100000000000; }
  function itemAmount(xs,i) { return xs.size() > i ? xs[i].amount : 0; }
  function total(xs) { return itemAmount(xs,0)+itemAmount(xs,1)+itemAmount(xs,2)+itemAmount(xs,3)+itemAmount(xs,4)+itemAmount(xs,5); }
  function changeAt(o,i,id,type,field) { return o.adjustments.size()>i && o.adjustments[i].id==id && o.adjustments[i].type==type && o.adjustments[i].field==field ? o.adjustments[i].delta : 0; }
  function delta(o,id,type,field) { let a=o.balanceChanges.get(id,{'type':'','field':'','delta':0});return a.type==type && a.field==field?a.delta:0; }
  function adjDelta(o,i) { return o.adjustments.size()>i ? o.adjustments[i].delta : 0; }
  function deltaTotal(o) { return adjDelta(o,0)+adjDelta(o,1)+adjDelta(o,2)+adjDelta(o,3)+adjDelta(o,4)+adjDelta(o,5); }
  function balanceCollection(a) { return a.type=='due'?'dues':'credits'; }
  function validAdjustment(o,i) {
   let a=o.adjustments.size()>i?o.adjustments[i]:null;
   return a==null || (a.keys().hasOnly(['id','type','field','before','after','delta']) && o.balanceChanges[a.id]==a && a.type in ['due','credit'] && a.delta is int && a.delta != 0 && after(balanceCollection(a),a.id).lastOperation==o.id
    && (o.kind=='payment' && a.delta>0 && a.field!='waived' || o.kind in ['refund','void'] && a.delta<0 && a.field!='waived' || o.kind=='waive' && a.field=='waived' && a.delta>0 || o.kind=='restoreWaiver' && a.field=='waived' && a.delta<0 || o.kind=='applyCredit' && (a.type=='credit' && a.field=='amount' && a.delta<0 || a.type=='due' && a.field=='paid' && a.delta>0)));
  }
  function ledgerAmount(o,i) { return o.ledgerIds.size()>i ? after('ledger',o.ledgerIds[i]).amount : 0; }
  function validLedger(o,i) { let l=o.ledgerIds.size()>i?after('ledger',o.ledgerIds[i]):null;return l==null || l.operationId==o.id && after('wallets',l.walletId).lastOperation==o.id; }
  function receiptLink(o) { return !(o.kind in ['payment','refund','void','applyCredit']) || after('receiptStates',o.receiptId).lastOperation==o.id; }
  function validEvent(o,id) {
   return o.keys().hasOnly(['id','kind','date','createdAt','actor','description','reason','receiptId','amount','adjustments','balanceChanges','ledgerIds','fundAmounts','targetId']) && o.id==id && o.actor==request.auth.uid && o.kind in ['saveHouse','saveMember','saveFund','saveSettings','saveSubMahal','saveWallet','assess','payment','waive','restoreWaiver','applyCredit','refund','void','cashbook','saveImportJob','deleteSubMahal'] && o.date is string && o.createdAt is string && o.description is string && o.reason is string && intAmount(o.amount) && o.adjustments is list && o.adjustments.size()<=4 && o.balanceChanges is map && o.balanceChanges.size()==o.adjustments.size() && o.adjustments.toSet().size()==o.adjustments.size() && o.ledgerIds is list && o.ledgerIds.size()<=2 && o.ledgerIds.toSet().size()==o.ledgerIds.size() && o.fundAmounts is list && o.fundAmounts.size()<=4
    && validAdjustment(o,0) && validAdjustment(o,1) && validAdjustment(o,2) && validAdjustment(o,3) && validAdjustment(o,4) && validAdjustment(o,5) && validLedger(o,0) && validLedger(o,1) && receiptLink(o)
    && (o.kind!='payment' || after('receipts',o.receiptId).total==o.amount && (after('receipts',o.receiptId).historical ? o.ledgerIds.size()==0 : o.ledgerIds.size()==1 && ledgerAmount(o,0)==o.amount))
    && (!(o.kind in ['refund','void']) || o.ledgerIds.size()==1 && ledgerAmount(o,0)==-o.amount && o.reason.size()>=3)
    && (!(o.kind in ['waive','restoreWaiver']) || o.ledgerIds.size()==0 && o.adjustments.size()==1 && o.reason.size()>=3)
    && (o.kind!='applyCredit' || o.adjustments.size()==2 && deltaTotal(o)==0 && o.ledgerIds.size()==0 && o.adjustments[0].type=='credit' && o.adjustments[1].type=='due' && after('credits',o.adjustments[0].id).payerId==after('dues',o.adjustments[1].id).payerId && after('credits',o.adjustments[0].id).fundId==after('dues',o.adjustments[1].id).fundId)
    && (o.kind!='cashbook' || o.ledgerIds.size()==1 && (ledgerAmount(o,0)==o.amount || ledgerAmount(o,0)==-o.amount) || o.ledgerIds.size()==2 && ledgerAmount(o,0)==-o.amount && ledgerAmount(o,1)==o.amount);
  }
  function amountFor(xs,i,id,type) { return xs.size()>i && (type=='due'?xs[i].dueId==id:xs[i].creditId==id)?xs[i].amount:0; }
  function allocated(xs,id,type) { return amountFor(xs,0,id,type)+amountFor(xs,1,id,type)+amountFor(xs,2,id,type)+amountFor(xs,3,id,type)+amountFor(xs,4,id,type)+amountFor(xs,5,id,type); }
  function stateAdjustment(o,i,oldMap,newMap) { return o.adjustments.size()<=i || newMap.get(o.adjustments[i].id,{'amount':0}).amount-oldMap.get(o.adjustments[i].id,{'amount':0}).amount==o.adjustments[i].delta; }
  function allocationKey(l) { return l.dueId!=''?l.dueId:l.creditId!=''?l.creditId:'voluntary_'+l.fundId; }
  function allocationAt(rs,i) { return rs.allocations.size()<=i || rs.allocationMap[allocationKey(rs.allocations[i])]==rs.allocations[i] && rs.allocations[i].amount is int && rs.allocations[i].amount>0; }
  function oldAllocation(o,i,old,d) {let l=old.allocations.size()>i?old.allocations[i]:null;let n=l==null?0:d.allocationMap.get(allocationKey(l),{'amount':0}).amount;return l==null || (l.dueId!=''?n-l.amount==delta(o,l.dueId,'due','paid'):l.creditId!=''?n-l.amount==delta(o,l.creditId,'credit','amount'):n<=l.amount && n>=0);}
  function conservedAllocations(o,old,d) {return d.allocationMap.diff(old.allocationMap).affectedKeys().hasOnly(old.allocationMap.keys().toSet().union(o.balanceChanges.keys().toSet())) && oldAllocation(o,0,old,d) && oldAllocation(o,1,old,d) && oldAllocation(o,2,old,d) && oldAllocation(o,3,old,d);}
  function validAllocationMap(rs) { return rs.allocationMap.size()==rs.allocations.size() && rs.allocations.toSet().size()==rs.allocations.size() && allocationAt(rs,0) && allocationAt(rs,1) && allocationAt(rs,2) && allocationAt(rs,3) && allocationAt(rs,4) && allocationAt(rs,5); }
  function paymentDue(d,id,o) {let l=after('receiptStates',o.receiptId).allocationMap[id];return l.dueId==id && l.creditId=='' && l.fundId==d.fundId && l.fundTitle==d.fundTitle && l.period==d.period && d.payerId==after('receipts',o.receiptId).payerId;}
  function dueUpdate(d,id) {let o=operation();let a=o.balanceChanges.get(id,null);return fresh(o) && validDue(d) && a!=null && a.type=='due' && a.field in ['paid','waived'] && d.diff(resource.data).affectedKeys().hasOnly([a.field,'lastOperation']) && a.before==resource.data[a.field] && a.after==d[a.field] && a.after-a.before==a.delta && d.lastOperation==o.id && after('publicDues',id)==d && (o.kind!='payment'||paymentDue(d,id,o));}
  function creditUpdate(d,id) {let o=operation();let a=o.balanceChanges.get(id,null);return fresh(o) && a!=null && a.type=='credit' && a.field=='amount' && intAmount(d.amount) && d.diff(resource.data).affectedKeys().hasOnly(['amount','lastOperation']) && a.before==resource.data.amount && a.after==d.amount && a.after-a.before==a.delta && d.lastOperation==o.id && after('publicCredits',id)==d;}
  function stateUpdate(d,id) {let o=operation();let r=after('receipts',id);let old=resource.data;return fresh(o) && o.receiptId==id && d.keys().hasOnly(['id','refunded','voided','allocations','allocationMap','lastOperation']) && d.id==id && d.lastOperation==o.id && old.voided==false && d.allocations.size()<=4 && validAllocationMap(d) && conservedAllocations(o,old,d) && d.refunded<=r.total && total(d.allocations)+d.refunded==r.total && stateAdjustment(o,0,old.allocationMap,d.allocationMap) && stateAdjustment(o,1,old.allocationMap,d.allocationMap) && stateAdjustment(o,2,old.allocationMap,d.allocationMap) && stateAdjustment(o,3,old.allocationMap,d.allocationMap) && (o.kind=='applyCredit' && d.refunded==old.refunded && d.voided==false || o.kind in ['refund','void'] && d.refunded==old.refunded+o.amount && d.voided==(o.kind=='void')) && after('publicReceipts',id).refunded==d.refunded && after('publicReceipts',id).voided==d.voided;}
  function privateReads(c) { return c in ['settings','subMahals','sequences','houses','members','funds','dues','credits','receipts','receiptStates','wallets','ledger','operations','importJobs','meta']; }
  match /{c}/{id} { allow read: if admin() && privateReads(c); }
  match /meta/revision {
   allow create: if admin() && request.resource.data.keys().hasOnly(['value','lastOperation']) && request.resource.data.value==0 && request.resource.data.lastOperation=='bootstrap';
   allow update: if admin() && request.resource.data.keys().hasOnly(['value','lastOperation']) && request.resource.data.value==resource.data.value+1 && fresh(after('operations',request.resource.data.lastOperation));
  }
  match /operations/{id} { allow create: if admin() && after('meta','revision').lastOperation==id && validEvent(request.resource.data,id); }
  match /settings/mahal { allow create: if admin() && bootstrap(); allow update: if edit('saveSettings') && request.resource.data.id=='mahal' && request.resource.data.schemaVersion==1 && request.resource.data.publicPhone is bool && request.resource.data.publicAddress is bool && request.resource.data.publicHistory is bool && after('publicSettings','mahal').publicPhone==request.resource.data.publicPhone && after('publicSettings','mahal').publicAddress==request.resource.data.publicAddress && after('publicSettings','mahal').publicHistory==request.resource.data.publicHistory; }
match /subMahals/{id} { allow create,update: if admin() && (bootstrap() || edit('saveSubMahal')) && request.resource.data.id==id && request.resource.data.name is string && request.resource.data.order>=1 && request.resource.data.order<=25; allow delete: if edit('deleteSubMahal') && operation().targetId==id; }
  function walletDelta(o,id,i) {let l=o.ledgerIds.size()>i?after('ledger',o.ledgerIds[i]):null;return l!=null && l.walletId==id?l.amount:0;}
  function walletUpdate(w,id) {let o=operation();return fresh(o) && w.lastOperation==o.id && intAmount(w.balance) && (o.kind=='saveWallet' && w.diff(resource.data).affectedKeys().hasOnly(['name','type','active','lastOperation']) || o.ledgerIds.size()>0 && w.diff(resource.data).affectedKeys().hasOnly(['balance','lastOperation']) && w.balance==resource.data.balance+walletDelta(o,id,0)+walletDelta(o,id,1));}
  match /wallets/{id} { allow create: if admin() && (bootstrap() || edit('saveWallet')) && request.resource.data.id==id && request.resource.data.keys().hasOnly(['id','name','type','active','balance','lastOperation']) && request.resource.data.balance==0 && request.resource.data.type in ['cash','bank'];allow update: if admin() && walletUpdate(request.resource.data,id); }
  match /sequences/{id} { allow create: if admin() && fresh(operation()) && request.resource.data.id==id && request.resource.data.value is int && request.resource.data.value>0; allow update: if admin() && fresh(operation()) && request.resource.data.id==id && request.resource.data.value is int && request.resource.data.value>resource.data.value; }
  match /houses/{id} { allow create,update: if edit('saveHouse') && request.resource.data.id==id && id.matches('H-[A-Z0-9][A-Z0-9_-]{0,63}') && request.resource.data.name is string && request.resource.data.subHistory is list && after('subMahals',request.resource.data.subMahalId).id==request.resource.data.subMahalId && after('publicHouses',id).name==request.resource.data.name; }
  match /members/{id} { allow create,update: if edit('saveMember') && request.resource.data.id==id && id.matches('M-[0-9]{6}') && request.resource.data.name is string && request.resource.data.approved is bool && request.resource.data.houseHistory is list && after('houses',request.resource.data.houseId).id==request.resource.data.houseId && after('publicMembers',id).name==request.resource.data.name && after('publicMembers',id).houseId==request.resource.data.houseId; }
  match /funds/{id} { allow create: if edit('saveFund') && request.resource.data.id==id && request.resource.data.target in ['member','house'] && request.resource.data.mode in ['fixed','voluntary'] && request.resource.data.frequency in ['annual','monthly','one_time']; allow update: if edit('saveFund') && request.resource.data.id==id && request.resource.data.target==resource.data.target && request.resource.data.mode==resource.data.mode && request.resource.data.frequency==resource.data.frequency && request.resource.data.rates.hasAll(resource.data.rates); }
  match /importJobs/{id} { allow create,update: if edit('saveImportJob') && request.resource.data.id==id; }
  function validDue(d) { return d.keys().hasOnly(['id','payerId','payerType','fundId','fundTitle','period','assessed','waived','paid','dueDate','rateFrom','lastOperation']) && intAmount(d.assessed) && d.assessed>0 && intAmount(d.waived) && intAmount(d.paid) && d.paid+d.waived<=d.assessed; }
  match /dues/{id} {
   allow create: if edit('assess') && request.resource.data.id==id && validDue(request.resource.data) && request.resource.data.paid==0 && request.resource.data.waived==0 && after('publicDues',id)==request.resource.data && request.resource.data.lastOperation==operation().id;
   allow update: if admin() && dueUpdate(request.resource.data,id);
  }
  match /credits/{id} {
   allow create: if edit('payment') && request.resource.data.keys().hasOnly(['id','payerId','fundId','receiptId','amount','period','lastOperation']) && request.resource.data.id==id && intAmount(request.resource.data.amount) && request.resource.data.amount==delta(operation(),id,'credit','amount') && request.resource.data.receiptId==operation().receiptId && request.resource.data.payerId==after('receipts',operation().receiptId).payerId && request.resource.data.fundId==after('receiptStates',operation().receiptId).allocationMap[id].fundId && operation().balanceChanges[id].before==0 && operation().balanceChanges[id].after==request.resource.data.amount && after('publicCredits',id)==request.resource.data;
   allow update: if admin() && creditUpdate(request.resource.data,id);
  }
  function lineValid(r,i,o) { let l=r.lines.size()>i?r.lines[i]:null;return l==null || l.keys().hasOnly(['fundId','fundTitle','period','dueId','creditId','amount']) && l.amount is int && l.amount>0 && (r.historical || l.dueId!='' && l.creditId=='' && l.amount==delta(o,l.dueId,'due','paid') || l.creditId!='' && l.dueId=='' && l.amount==delta(o,l.creditId,'credit','amount') || l.dueId=='' && l.creditId=='' && after('funds',l.fundId).mode=='voluntary' && after('funds',l.fundId).target==r.payerType); }
  function voluntary(r,i) { return r.lines.size()>i && r.lines[i].dueId=='' && r.lines[i].creditId=='' ? r.lines[i].amount:0; }
  function voluntaryTotal(r) { return voluntary(r,0)+voluntary(r,1)+voluntary(r,2)+voluntary(r,3)+voluntary(r,4)+voluntary(r,5); }
  function receiptCreate(r,id) {let o=operation();return fresh(o) && o.kind=='payment' && r.id==id && r.operationId==o.id && o.receiptId==id && r.lines.size()>0 && r.lines.size()<=4 && intAmount(r.total) && total(r.lines)==r.total && lineValid(r,0,o) && lineValid(r,1,o) && lineValid(r,2,o) && lineValid(r,3,o) && after('receiptStates',id).allocations==r.lines && after('publicReceipts',id).total==r.total && after('receiptNumbers',r.number).receiptId==id;}
  match /receipts/{id} { allow create: if admin() && receiptCreate(request.resource.data,id); }
  match /receiptNumbers/{number} { allow read: if admin(); allow create: if edit('payment') && request.resource.data.keys().hasOnly(['receiptId']) && after('receipts',request.resource.data.receiptId).number==number; }
  match /receiptStates/{id} {
   allow create: if edit('payment') && request.resource.data.id==id && request.resource.data.refunded==0 && request.resource.data.voided==false && request.resource.data.allocations==after('receipts',id).lines && validAllocationMap(request.resource.data) && request.resource.data.lastOperation==operation().id;
   allow update: if admin() && stateUpdate(request.resource.data,id);
  }
  function cashbookKind(l,o) {return l.receiptId=='' && (l.kind=='income' && l.amount>0 || l.kind=='expense' && l.amount<0 || l.kind=='opening' && l.amount>0 && after('openingEntries',l.walletId).ledgerId==l.id || l.kind=='transfer' && o.ledgerIds.size()==2 && after('ledger',o.ledgerIds[0]).kind=='transfer' && after('ledger',o.ledgerIds[1]).kind=='transfer' && after('ledger',o.ledgerIds[0]).walletId!=after('ledger',o.ledgerIds[1]).walletId);}
  function ledgerEntry(l,id) {let o=operation();return fresh(o) && l.keys().hasOnly(['id','date','walletId','amount','kind','category','party','description','reference','receiptId','operationId']) && l.id==id && l.date==o.date && l.operationId==o.id && id in o.ledgerIds && l.amount is int && l.amount!=0 && after('wallets',l.walletId).active && (o.kind=='payment' && l.kind=='collection' && l.receiptId==o.receiptId && l.walletId==after('receipts',o.receiptId).walletId && l.amount>0 || o.kind in ['refund','void'] && l.kind==(o.kind=='void'?'reversal':'refund') && l.receiptId==o.receiptId && l.amount<0 || o.kind=='cashbook' && cashbookKind(l,o));}
  match /ledger/{id} { allow create: if admin() && ledgerEntry(request.resource.data,id); }
  match /openingEntries/{id} {allow read: if admin();allow create: if edit('cashbook') && request.resource.data.keys().hasOnly(['ledgerId']) && after('ledger',request.resource.data.ledgerId).kind=='opening' && after('ledger',request.resource.data.ledgerId).walletId==id;}
  function publicRead() { return request.query.limit!=null && request.query.limit<=100; }
  function historyVisible() { return before('publicSettings','mahal').publicHistory; }
  function policyVersion(s) {return (s.publicPhone?'1':'0')+(s.publicAddress?'1':'0')+(s.publicHistory?'1':'0');}
  match /publicSettings/mahal { allow read: if true; allow create,update: if admin() && request.resource.data.keys().hasOnly(['id','name','address','contact','logo','timezone','publicPhone','publicAddress','publicHistory','version']) && request.resource.data.id=='mahal' && request.resource.data.name==after('settings','mahal').name && request.resource.data.publicPhone==after('settings','mahal').publicPhone && request.resource.data.publicAddress==after('settings','mahal').publicAddress && request.resource.data.publicHistory==after('settings','mahal').publicHistory && request.resource.data.version==policyVersion(after('settings','mahal')); }
  function currentVersion(d) { return d.version==before('publicSettings','mahal').version; }
  match /publicMembers/{id} {
   allow get: if currentVersion(resource.data); allow list: if publicRead() && currentVersion(resource.data);
   allow create,update: if admin() && request.resource.data.keys().hasOnly(['id','name','nameKey','phone','phoneKey','houseId','active','version']) && request.resource.data.id==id && request.resource.data.name==after('members',id).name && request.resource.data.houseId==after('members',id).houseId && request.resource.data.active==after('members',id).active && request.resource.data.phone==(after('settings','mahal').publicPhone?after('members',id).phone:'') && request.resource.data.version==after('publicSettings','mahal').version;
  }
  match /publicHouses/{id} {
   allow get: if currentVersion(resource.data); allow list: if publicRead() && currentVersion(resource.data);
   allow create,update: if admin() && request.resource.data.keys().hasOnly(['id','name','nameKey','number','numberKey','phone','phoneKey','address','subMahalId','subMahalName','active','version']) && request.resource.data.id==id && request.resource.data.name==after('houses',id).name && request.resource.data.number==after('houses',id).number && request.resource.data.subMahalId==after('houses',id).subMahalId && request.resource.data.active==after('houses',id).active && request.resource.data.phone==(after('settings','mahal').publicPhone?after('houses',id).phone:'') && request.resource.data.address==(after('settings','mahal').publicAddress?after('houses',id).address:'') && request.resource.data.version==after('publicSettings','mahal').version;
  }
  match /publicDues/{id} { allow get: if historyVisible(); allow list: if historyVisible() && publicRead(); allow create,update: if admin() && request.resource.data==after('dues',id); }
  match /publicCredits/{id} { allow get: if historyVisible(); allow list: if historyVisible() && publicRead(); allow create,update: if admin() && request.resource.data==after('credits',id); }
  function publicReceipt(d,id) {let r=after('receipts',id);let rs=after('receiptStates',id);return d.keys().hasOnly(['id','number','payerId','payerType','payerName','houseId','houseName','subMahalId','subMahalName','date','postedAt','method','lines','total','outstandingAfter','advanceAfter','historical','legacyNumber','refunded','voided']) && d.id==id && d.number==r.number && d.payerId==r.payerId && d.payerType==r.payerType && d.payerName==r.payerName && d.houseId==r.houseId && d.houseName==r.houseName && d.subMahalId==r.subMahalId && d.subMahalName==r.subMahalName && d.date==r.date && d.postedAt==r.postedAt && d.method==r.method && d.lines==r.lines && d.total==r.total && d.outstandingAfter==r.outstandingAfter && d.advanceAfter==r.advanceAfter && d.historical==r.historical && d.legacyNumber==r.legacyNumber && d.refunded==rs.refunded && d.voided==rs.voided;}
  match /publicReceipts/{id} { allow get: if historyVisible(); allow list: if historyVisible() && publicRead(); allow create,update: if admin() && publicReceipt(request.resource.data,id); }
 }
}
